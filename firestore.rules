rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'cesarluzz76@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidMarket(m) {
      return m is string && m in ['ALL', 'BR', 'US'];
    }

    function isValidCurrency(c) {
      return c is string && c in ['BRL', 'USD'];
    }

    function isValidPlan(p) {
      return p is string && p in ['FREE', 'PRO', 'PREMIUM'];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'plan', 'preferredMarket', 'preferredCurrency', 'financialGoal', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoUrl', 'plan', 'preferredMarket', 'preferredCurrency', 'financialGoal', 'lgpdConsentAt', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && isValidPlan(data.plan)
        && isValidMarket(data.preferredMarket)
        && isValidCurrency(data.preferredCurrency)
        && data.financialGoal is number && data.financialGoal >= 0
        && (!('lgpdConsentAt' in data) || (data.lgpdConsentAt is string && data.lgpdConsentAt.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPortfolio(data, userId, portfolioId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'currency', 'goalAmount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'currency', 'goalAmount', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == portfolioId && isValidId(data.id)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && isValidCurrency(data.currency)
        && data.goalAmount is number && data.goalAmount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data, userId, txId) {
      return data.keys().hasAll(['id', 'userId', 'portfolioId', 'ticker', 'market', 'assetType', 'operationType', 'quantity', 'unitPrice', 'fees', 'brokerage', 'fxRate', 'currency', 'date', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'portfolioId', 'ticker', 'market', 'assetType', 'operationType', 'quantity', 'unitPrice', 'fees', 'brokerage', 'fxRate', 'currency', 'date', 'notes', 'splitRatio', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == txId && isValidId(data.id)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.portfolioId is string && isValidId(data.portfolioId)
        && data.ticker is string && data.ticker.size() >= 1 && data.ticker.size() <= 20
        && data.market in ['BR', 'US']
        && data.assetType in ['STOCK', 'FII', 'ETF', 'BDR', 'REIT', 'ADR', 'INDEX']
        && data.operationType in ['BUY', 'SELL', 'SPLIT', 'REVERSE_SPLIT', 'BONUS', 'AMORTIZATION', 'DIVIDEND']
        && data.quantity is number && data.quantity >= 0
        && data.unitPrice is number && data.unitPrice >= 0
        && data.fees is number && data.fees >= 0
        && data.brokerage is number && data.brokerage >= 0
        && data.fxRate is number && data.fxRate > 0
        && isValidCurrency(data.currency)
        && data.date is string && data.date.size() == 10
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && (!('splitRatio' in data) || (data.splitRatio is number && data.splitRatio > 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAlert(data, userId, alertId) {
      return data.keys().hasAll(['id', 'userId', 'ticker', 'market', 'alertType', 'targetValue', 'channels', 'frequency', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'ticker', 'market', 'alertType', 'targetValue', 'channels', 'frequency', 'active', 'lastTriggeredAt', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == alertId && isValidId(data.id)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.ticker is string && data.ticker.size() >= 1 && data.ticker.size() <= 20
        && data.market in ['BR', 'US']
        && data.alertType in ['PRICE_BELOW', 'PRICE_ABOVE', 'CONSENSUS_3X', 'CONSENSUS_4X', 'CONSENSUS_5X', 'DIVIDEND_YIELD', 'FUNDAMENTAL_CHANGE', 'EARNINGS']
        && data.targetValue is number && data.targetValue >= 0
        && data.channels is list && data.channels.size() >= 1 && data.channels.size() <= 3 && data.channels[0] is string
        && data.frequency in ['REALTIME', 'HOURLY', 'DAILY']
        && data.active is bool
        && (!('lastTriggeredAt' in data) || (data.lastTriggeredAt is string && data.lastTriggeredAt.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data, userId, notifId) {
      return data.keys().hasAll(['id', 'userId', 'ticker', 'title', 'message', 'read', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'alertId', 'ticker', 'title', 'message', 'read', 'createdAt'])
        && data.id is string && data.id == notifId && isValidId(data.id)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && (!('alertId' in data) || (data.alertId is string && data.alertId.size() <= 128))
        && data.ticker is string && data.ticker.size() >= 1 && data.ticker.size() <= 20
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 400
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidWatchlistItem(data, userId, itemId) {
      return data.keys().hasAll(['id', 'userId', 'ticker', 'market', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'ticker', 'market', 'notes', 'createdAt'])
        && data.id is string && data.id == itemId && isValidId(data.id)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.ticker is string && data.ticker.size() >= 1 && data.ticker.size() <= 20
        && data.market in ['BR', 'US']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.createdAt is timestamp;
    }

    function isValidSavedFilter(data, userId, filterId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'market', 'consensusLevel', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'market', 'sector', 'maxPE', 'minROE', 'minDY', 'consensusLevel', 'createdAt'])
        && data.id is string && data.id == filterId && isValidId(data.id)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && isValidMarket(data.market)
        && (!('sector' in data) || (data.sector is string && data.sector.size() <= 80))
        && (!('maxPE' in data) || data.maxPE is number)
        && (!('minROE' in data) || data.minROE is number)
        && (!('minDY' in data) || data.minDY is number)
        && data.consensusLevel in ['ALL', '3X', '4X', '5X']
        && data.createdAt is timestamp;
    }

    function isValidSubscription(data, userId, subId) {
      return data.keys().hasAll(['id', 'userId', 'plan', 'status', 'provider', 'amount', 'currency', 'billingCycle', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'plan', 'status', 'provider', 'amount', 'currency', 'billingCycle', 'updatedAt'])
        && data.id is string && data.id == subId && isValidId(data.id)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && isValidPlan(data.plan)
        && data.status in ['ACTIVE', 'CANCELLED', 'PAST_DUE']
        && data.provider in ['STRIPE', 'MERCADO_PAGO', 'ADMIN_GRANT']
        && data.amount is number && data.amount >= 0
        && isValidCurrency(data.currency)
        && data.billingCycle in ['MONTHLY', 'ANNUAL']
        && data.updatedAt is timestamp;
    }

    function isValidPayment(data, userId, paymentId) {
      return data.keys().hasAll(['id', 'userId', 'plan', 'amount', 'currency', 'provider', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'plan', 'amount', 'currency', 'provider', 'status', 'createdAt'])
        && data.id is string && data.id == paymentId && isValidId(data.id)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.plan in ['PRO', 'PREMIUM']
        && data.amount is number && data.amount >= 0
        && isValidCurrency(data.currency)
        && data.provider in ['STRIPE', 'MERCADO_PAGO']
        && data.status in ['PAID', 'REFUNDED', 'FAILED']
        && data.createdAt is timestamp;
    }

    function isValidPlatformConfig(data) {
      return data.keys().hasAll(['bazinRate', 'targetPE', 'minMarginOfSafety', 'dcfWacc', 'dcfPerpetualGrowth', 'proMonthlyPriceBRL', 'premiumMonthlyPriceBRL', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['bazinRate', 'targetPE', 'minMarginOfSafety', 'dcfWacc', 'dcfPerpetualGrowth', 'proMonthlyPriceBRL', 'premiumMonthlyPriceBRL', 'updatedBy', 'updatedAt'])
        && data.bazinRate is number && data.bazinRate > 0 && data.bazinRate <= 0.5
        && data.targetPE is number && data.targetPE > 0 && data.targetPE <= 100
        && data.minMarginOfSafety is number && data.minMarginOfSafety >= 0 && data.minMarginOfSafety <= 90
        && data.dcfWacc is number && data.dcfWacc > 0 && data.dcfWacc <= 0.5
        && data.dcfPerpetualGrowth is number && data.dcfPerpetualGrowth >= 0 && data.dcfPerpetualGrowth <= 0.15
        && data.proMonthlyPriceBRL is number && data.proMonthlyPriceBRL >= 0
        && data.premiumMonthlyPriceBRL is number && data.premiumMonthlyPriceBRL >= 0
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 200
        && data.updatedAt is timestamp;
    }

    function isValidParameterHistory(data, historyId) {
      return data.keys().hasAll(['id', 'changedBy', 'summary', 'bazinRate', 'targetPE', 'minMarginOfSafety', 'createdAt'])
        && data.keys().hasOnly(['id', 'changedBy', 'summary', 'bazinRate', 'targetPE', 'minMarginOfSafety', 'createdAt'])
        && data.id is string && data.id == historyId && isValidId(data.id)
        && data.changedBy is string && data.changedBy.size() >= 1 && data.changedBy.size() <= 200
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500
        && data.bazinRate is number
        && data.targetPE is number
        && data.minMarginOfSafety is number
        && data.createdAt is timestamp;
    }

    function isValidAuditLog(data, logId) {
      return data.keys().hasAll(['id', 'actorUid', 'action', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorUid', 'action', 'target', 'createdAt'])
        && data.id is string && data.id == logId && isValidId(data.id)
        && data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 120
        && (!('target' in data) || (data.target is string && data.target.size() <= 200))
        && data.createdAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if isAdmin() && isValidId(adminId);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().plan == 'FREE'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().plan == existing().plan
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'preferredMarket', 'preferredCurrency', 'financialGoal', 'lgpdConsentAt', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isVerified() && (isOwner(userId) || isAdmin());

      match /portfolios/{portfolioId} {
        allow get: if isValidId(userId) && isValidId(portfolioId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && ((isOwner(userId) && existing().userId == request.auth.uid) || isAdmin());
        allow create: if isValidId(userId) && isValidId(portfolioId)
          && isVerified() && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidPortfolio(incoming(), userId, portfolioId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(portfolioId)
          && isVerified() && isOwner(userId)
          && isValidPortfolio(incoming(), userId, portfolioId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'currency', 'goalAmount', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(portfolioId) && isVerified() && isOwner(userId);
      }

      match /transactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && ((isOwner(userId) && existing().userId == request.auth.uid) || isAdmin());
        allow create: if isValidId(userId) && isValidId(txId)
          && isVerified() && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId)/portfolios/$(incoming().portfolioId))
          && isValidTransaction(incoming(), userId, txId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(txId)
          && isVerified() && isOwner(userId)
          && isValidTransaction(incoming(), userId, txId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['ticker', 'market', 'assetType', 'operationType', 'quantity', 'unitPrice', 'fees', 'brokerage', 'fxRate', 'currency', 'date', 'notes', 'splitRatio', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(txId) && isVerified() && isOwner(userId);
      }

      match /alerts/{alertId} {
        allow get: if isValidId(userId) && isValidId(alertId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && ((isOwner(userId) && existing().userId == request.auth.uid) || isAdmin());
        allow create: if isValidId(userId) && isValidId(alertId)
          && isVerified() && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidAlert(incoming(), userId, alertId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(alertId)
          && isVerified() && isOwner(userId)
          && isValidAlert(incoming(), userId, alertId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['targetValue', 'channels', 'frequency', 'active', 'lastTriggeredAt', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(alertId) && isVerified() && isOwner(userId);
      }

      match /notifications/{notifId} {
        allow get: if isValidId(userId) && isValidId(notifId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && ((isOwner(userId) && existing().userId == request.auth.uid) || isAdmin());
        allow create: if isValidId(userId) && isValidId(notifId)
          && isVerified() && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidNotification(incoming(), userId, notifId)
          && incoming().createdAt == request.time;
        allow update: if isValidId(userId) && isValidId(notifId)
          && isVerified() && isOwner(userId)
          && isValidNotification(incoming(), userId, notifId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isValidId(userId) && isValidId(notifId) && isVerified() && isOwner(userId);
      }

      match /watchlists/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && ((isOwner(userId) && existing().userId == request.auth.uid) || isAdmin());
        allow create: if isValidId(userId) && isValidId(itemId)
          && isVerified() && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidWatchlistItem(incoming(), userId, itemId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(itemId) && isVerified() && isOwner(userId);
      }

      match /saved_filters/{filterId} {
        allow get: if isValidId(userId) && isValidId(filterId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && ((isOwner(userId) && existing().userId == request.auth.uid) || isAdmin());
        allow create: if isValidId(userId) && isValidId(filterId)
          && isVerified() && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidSavedFilter(incoming(), userId, filterId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(filterId) && isVerified() && isOwner(userId);
      }

      match /subscriptions/{subId} {
        allow get: if isValidId(userId) && isValidId(subId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && ((isOwner(userId) && existing().userId == request.auth.uid) || isAdmin());
        allow create, update: if isValidId(userId) && isValidId(subId)
          && isAdmin()
          && isValidSubscription(incoming(), userId, subId)
          && incoming().updatedAt == request.time;
        allow delete: if isValidId(userId) && isValidId(subId) && isAdmin();
      }

      match /payments/{paymentId} {
        allow get: if isValidId(userId) && isValidId(paymentId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && ((isOwner(userId) && existing().userId == request.auth.uid) || isAdmin());
        allow create: if isValidId(userId) && isValidId(paymentId)
          && isAdmin()
          && isValidPayment(incoming(), userId, paymentId)
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /config/{docId} {
      allow get: if isValidId(docId);
      allow list: if false;
      allow create, update: if isValidId(docId)
        && isAdmin()
        && isValidPlatformConfig(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /parameter_history/{historyId} {
      allow get: if isValidId(historyId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(historyId)
        && isAdmin()
        && isValidParameterHistory(incoming(), historyId)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId)
        && isVerified()
        && incoming().actorUid == request.auth.uid
        && isValidAuditLog(incoming(), logId)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
